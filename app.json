{
  "expo": {
    "name": "InvoiceFlow",
    "slug": "invoiceflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coolrunnerplays.invoiceflow"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "InvoiceFlow",
      "themeColor": "#111827",
      "backgroundColor": "#111827"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      "expo-secure-store",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow InvoiceFlow to scan your invoices."
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "invoiceflow"
  }
}
